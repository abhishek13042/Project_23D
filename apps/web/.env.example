# Copy to .env.local for local work. All optional: the site explains what is missing.

# Folder holding the sample cases, for example the Hugging Face dataset's resolve/main URL.
# Locally, /gallery-local serves cases copied into public/gallery-local.
NEXT_PUBLIC_GALLERY_BASE_URL=/gallery-local

# Hugging Face Space that runs the model, as owner/name
NEXT_PUBLIC_SPACE_ID=

# Public GitHub repository, used for source and notebook links
NEXT_PUBLIC_REPO_URL=

# Neon connection string. Server only: never add the NEXT_PUBLIC_ prefix.
DATABASE_URL=
